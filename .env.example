# Neon: Dashboard > your project > Connection string (pooled)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Any long random string. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-32-random-bytes"

# Your live URL, no trailing slash. Used for SEO metadata.
NEXT_PUBLIC_SITE_URL="https://devspec.app"

# Optional. Leave unset and registration is open to anyone, which is the
# default. Set it to a comma separated list to close registration to those
# addresses only, no code change needed.
# ALLOWED_EMAILS="you@example.com,colleague@example.com"
